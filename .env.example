# VitalTrack — Environment Variables
# Copy to .env.local for local development
# Set these in Vercel Dashboard > Settings > Environment Variables for production

# Gemini API key from Google AI Studio (najmschild@gmail.com)
GEMINI_API_KEY=your_gemini_api_key_here

# App-level API key for authenticating Flutter/Web clients
# Generate a random string: openssl rand -hex 32
VT_APP_KEY=your_app_key_here
